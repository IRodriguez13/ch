# bash completion for ch-adds(1) -*- shell-script -*-

_ch_adds_refs()
{
	local refs='HEAD develop'

	if git rev-parse --git-dir >/dev/null 2>&1; then
		refs="$refs $(git for-each-ref --format='%(refname:short)' refs/heads refs/tags 2>/dev/null)"
	fi
	COMPREPLY=( $( compgen -W "$refs" -- "$cur" ) )
	compopt -o filenames 2>/dev/null
	COMPREPLY+=( $( compgen -f -X '!*.patch' -- "$cur" ) )
}

_ch_adds()
{
	local cur prev words cword
	_init_completion || return

	local flags='-r --ref -p --patch --staged --unstaged -2 --two-dot -x --exact
	             -q --quiet -0 --plain -d --removed -h --help -V --version'

	case $prev in
		-h|--help|-V|--version)
			return
			;;
		-r|--ref)
			_ch_adds_refs
			return
			;;
		-p|--patch)
			compopt -o filenames 2>/dev/null
			COMPREPLY=( $( compgen -f -- "$cur" ) )
			return
			;;
	esac

	if [[ $cur == -* ]]; then
		COMPREPLY=( $( compgen -W "$flags" -- "$cur" ) )
		return
	fi

	local i have_file=0
	for (( i=1; i < cword; i++ )); do
		case ${words[i]} in
			-r|--ref|-p|--patch)
				(( i++ ))
				continue
				;;
			--staged|--unstaged|-2|--two-dot|-x|--exact|-q|--quiet|-0|--plain|-d|--removed|-h|--help|-V|--version)
				continue
				;;
			-*)
				continue
				;;
			*)
				have_file=1
				break
				;;
		esac
	done

	if (( have_file == 0 )); then
		compopt -o filenames 2>/dev/null
		COMPREPLY=( $( compgen -f -- "$cur" ) )
	else
		_ch_adds_refs
	fi
} &&
	complete -F _ch_adds ch-adds ch

