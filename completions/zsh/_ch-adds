#compdef ch-adds ch
# zsh completion for ch-adds(1)

_ch_adds_refs() {
	local -a refs
	refs=(HEAD develop)
	if git rev-parse --git-dir >/dev/null 2>&1; then
		refs+=(${(f)"$(git for-each-ref --format='%(refname:short)' refs/heads refs/tags 2>/dev/null)"})
	fi
	_describe -t refs 'git reference' refs
	_files -g '*.patch'
}

_ch_adds() {
	local curcontext="$curcontext" state line
	typeset -A opt_args

	_arguments -s -S \
		'(-r --ref)'{-r+,--ref=}'[Git reference or range]:reference:_ch_adds_refs' \
		'(-p --patch)'{-p+,--patch=}'[Read from patch file]:patch:_files -g "*.patch"' \
		'--staged[Only staged changes (git diff --cached)]' \
		'--unstaged[Only unstaged changes]' \
		'(-2 --two-dot)'{-2,--two-dot}'[Use branch..HEAD instead of 3-dot]' \
		'(-x --exact)'{-x,--exact}'[Diff directly against REF]' \
		'(-q --quiet)'{-q,--quiet}'[No header or line numbers]' \
		'(-0 --plain)'{-0,--plain}'[With -q: omit +/- prefixes]' \
		'(-d --removed)'{-d,--removed}'[Also show removed lines]' \
		'(-h --help)'{-h,--help}'[Show help]' \
		'(-V --version)'{-V,--version}'[Show version and license]' \
		'1:file:_files' \
		'2:reference:_ch_adds_refs'
}

_ch_adds "$@"
